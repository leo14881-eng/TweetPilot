# 复制为 .env 后填写。.env 不要提交到 git。

# X 小号的 auth_token（浏览器登录小号后，在 Cookie 里找 auth_token 的值）
TWITTER_AUTH_TOKEN=

# Telegram 推送（可以复用 PhoenixScout / TrendPilot 的机器人）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 监听的账号，用英文逗号分隔
ACCOUNTS=elonmusk,cz_binance,justinsuntron

# 多久检查一次（秒）
POLL_SECONDS=60

# 1 = 不推送回复别人的推文，只推主帖；0 = 全部推送
EXCLUDE_REPLIES=1
