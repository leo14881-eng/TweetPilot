# TweetPilot 设置。复制到 config\tweetpilot.env 后修改，保存后 5 分钟内自动同步到服务器并生效。
# 这个文件里有密码类信息，不要发到聊天里，也不要提交到 git。

# ===== 监听的账号 =====
# 格式：用户名:中文名，多个用英文逗号分隔（用户名就是 x.com/ 后面那段）
ACCOUNTS=elonmusk:马斯克,cz_binance:赵长鹏,justinsuntron:孙宇晨

# 多久检查一次（秒，建议 60）
POLL_SECONDS=60

# 1 = 只推主帖，不推回复别人的推文；0 = 回复也推
EXCLUDE_REPLIES=1

# 连续多少分钟读不到推文就提醒（通常是小号登录过期）
ALERT_AFTER_FAIL_MINUTES=30

# ===== Telegram（TweetPilot 专用机器人）=====
# 在 @BotFather 创建机器人后得到的 token
TELEGRAM_BOT_TOKEN=
# 可以留空：给机器人发一条消息后会自动获取
TELEGRAM_CHAT_ID=

# ===== X 小号凭证 =====
# 可以写在这里，也可以放在 config\x-auth-token.txt（二选一，这里优先）
TWITTER_AUTH_TOKEN=
