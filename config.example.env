# TweetPilot 设置。复制到 config\tweetpilot.env 后修改，保存后 5 分钟内自动同步到服务器并生效。
# 这个文件里有密码类信息，不要发到聊天里，也不要提交到 git。

# ===== 监听的账号 =====
# 格式：用户名:中文名，多个用英文逗号分隔（用户名就是 x.com/ 后面那段）
ACCOUNTS=elonmusk:马斯克,cz_binance:赵长鹏,justinsuntron:孙宇晨

# 多久检查一次（秒，建议 60）
POLL_SECONDS=60

# 1 = 只推主帖，不推回复别人的推文；0 = 回复也推
EXCLUDE_REPLIES=1

# 1 = 也推送转发别人的推文；0 = 只推本人发的（默认）
INCLUDE_RETWEETS=0

# 超过多少分钟的旧推文不推送
MAX_AGE_MINUTES=120

# 连续多少分钟读不到推文就提醒（通常是小号登录过期）
ALERT_AFTER_FAIL_MINUTES=30

# ===== 翻译兜底（可选，付费）=====
# 只有谷歌、微软、MyMemory 三个免费翻译都失败时才调用 ChatGPT。不填就不用。
OPENAI_API_KEY=
# 用 OpenRouter 等兼容接口时改这里，例如 https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== 经济 / 科技 / 加密要闻（需要上面的 OPENAI_API_KEY）=====
# 1 = 开启，0 = 关闭
NEWS_ENABLED=1
# 多久检查一次（秒）
NEWS_POLL_SECONDS=180
# 快讯类 X 账号（ChatGPT 只挑重要的推送）
NEWS_X_ACCOUNTS=DeItaone,FirstSquawk
# 每天几点（越南时间）推送 24 小时汇总，-1 = 不推送
DAILY_DIGEST_HOUR=14

# ===== Telegram（TweetPilot 专用机器人）=====
# 在 @BotFather 创建机器人后得到的 token
TELEGRAM_BOT_TOKEN=
# 可以留空：给机器人发一条消息后会自动获取
TELEGRAM_CHAT_ID=

# ===== X 小号凭证 =====
# 可以写在这里，也可以放在 config\x-auth-token.txt（二选一，这里优先）
TWITTER_AUTH_TOKEN=
